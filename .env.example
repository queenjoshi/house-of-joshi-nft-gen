# WalletConnect Project ID for RainbowKit
# Get your project ID from https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Reown Project ID (deprecated - kept for reference)
NEXT_PUBLIC_REOWN_PROJECT_ID=

# HOJNFTGen factory deployments
NEXT_PUBLIC_HOJ_FACTORY_BASE=0x303c77cDAf1C6799533D9cD234C05633Ce476467
NEXT_PUBLIC_HOJ_FACTORY_BASE_SEPOLIA=
NEXT_PUBLIC_DREAMWEAVER_CONTRACT=0xd426105F39C8B0d192496e8aBfaD4a2D7686a8E6
NEXT_PUBLIC_DREAMWEAVER_SIGNER_ADDRESS=0x769c118906c7E25d3cdfd943ce9a0B8Aab56eFeE
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Pinata IPFS Configuration
# Get your API keys from https://app.pinata.cloud/
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_API_KEY=your_pinata_secret_api_key
PINATA_JWT=your_pinata_jwt_token
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs


# BaseScan API Key for contract verification
# Get your API key from https://basescan.org/myapikey
# Server-only Etherscan V2 key used to verify contracts on Base/Base Sepolia.
# Do not expose this value with a NEXT_PUBLIC_ prefix.
ETHERSCAN_API_KEY=your_etherscan_api_key

# AI Generation APIs
# Stability AI API Key for image generation
# Get your API key from https://platform.stability.ai/
STABILITY_API_KEY=your_stability_ai_api_key

# Background Removal API Key (remove.bg)
# Get your API key from https://www.remove.bg/api
REMOVAL_API_KEY=your_remove_bg_api_key
